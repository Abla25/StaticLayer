# StaticLayer Web Installer — real Cloudflare connection (local only, never commit).
# Copy this file to `.env.local` (same folder) and fill in your real values.
#   cp apps/installer/.env.example apps/installer/.env.local
# Then run:  npm run dev:installer:real   (http://localhost:8788)

# Dev mode: NO email needed — the wizard has a "Continue →" local button that
# creates the session directly. The magic link (email) is optional/secondary.
STATICLAYER_DEV_MODE=1

# From Cloudflare dashboard → Manage Account → OAuth clients → Create client.
# ONLY needed for "Option A — Connect with Cloudflare" (OAuth). If you leave the
# placeholders, the wizard hides Option A and you can still install with an
# API token (Option B), which needs NO OAuth client registration.
STATICLAYER_CLIENT_ID=your_oauth_client_id
STATICLAYER_CLIENT_SECRET=your_oauth_client_secret

# Must match EXACTLY one of the Redirect URLs you registered on the client.
STATICLAYER_REDIRECT_URI=http://localhost:8788/oauth/callback

# HMAC secret for magic links + session cookies (generate: openssl rand -hex 32).
STATICLAYER_SESSION_SECRET=replace_me_with_openssl_rand_hex_32

# Optional overrides
# STATICLAYER_INSTALLER_URL=http://localhost:8788
# PORT=8788
